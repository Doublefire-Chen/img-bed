# systemd unit for img-bed. Install as /etc/systemd/system/img-bed.service
# (see deploy/README.md). Logs go to the journal: journalctl -u img-bed

[Unit]
Description=img-bed image host
Documentation=https://github.com/Doublefire-Chen/img-bed/blob/main/deploy/README.md
After=network.target

[Service]
Type=exec
User=img-bed
Group=img-bed
ExecStart=/opt/img-bed/current/img-bed serve --config /etc/img-bed/img-bed.toml
Restart=on-failure
RestartSec=2s
# SIGTERM triggers a graceful shutdown (in-flight requests finish).
TimeoutStopSec=30s
Environment=RUST_LOG=info
UMask=0027

# Hardening. The only writable place is the data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/img-bed
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
